{
  "name": "bonk-turbo-lite",
  "productName": "Bonk Turbo Lite",
  "version": "1.5.2",
  "description": "Launcher do bonk.io focado em input lag e desempenho, com controle total do lobby.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/patch-test.js",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "io.bonkturbo.lite",
    "productName": "Bonk Turbo Lite",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "Bonk Turbo Lite Setup ${version}.exe"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "45.1.0",
    "electron-builder": "26.18.0"
  }
}
